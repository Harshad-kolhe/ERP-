## ---------------------------------------------------------------------------
## Single style source for the whole repo (C# + TypeScript).
## Enforced in CI by `dotnet format --verify-no-changes` and `pnpm lint`.
## ---------------------------------------------------------------------------
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,csx}]
indent_size = 4

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{sln,csproj,props,targets}]
indent_size = 2

## ---------------------------------------------------------------------------
## C#
## ---------------------------------------------------------------------------
[*.cs]
# --- Language conventions -------------------------------------------------
csharp_style_namespace_declarations = file_scoped:error
csharp_using_directive_placement = outside_namespace:error
csharp_prefer_braces = true:warning
csharp_style_prefer_primary_constructors = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:silent
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion
csharp_prefer_simple_using_statement = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_throw_expression = true:suggestion
csharp_style_prefer_null_check_over_type_check = true:suggestion

dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
dotnet_style_readonly_field = true:warning
dotnet_style_require_accessibility_modifiers = for_non_interface_members:error
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_null_propagation = true:suggestion
dotnet_style_object_initializer = true:suggestion
dotnet_style_prefer_conditional_expression_over_assignment = true:silent
dotnet_style_prefer_conditional_expression_over_return = true:silent

# --- Naming ---------------------------------------------------------------
dotnet_naming_rule.interfaces_start_with_i.symbols = interface_symbol
dotnet_naming_rule.interfaces_start_with_i.style = prefix_i_style
dotnet_naming_rule.interfaces_start_with_i.severity = error
dotnet_naming_symbols.interface_symbol.applicable_kinds = interface
dotnet_naming_style.prefix_i_style.required_prefix = I
dotnet_naming_style.prefix_i_style.capitalization = pascal_case

dotnet_naming_rule.types_are_pascal_case.symbols = type_symbol
dotnet_naming_rule.types_are_pascal_case.style = pascal_style
dotnet_naming_rule.types_are_pascal_case.severity = error
dotnet_naming_symbols.type_symbol.applicable_kinds = class,struct,enum,delegate
dotnet_naming_style.pascal_style.capitalization = pascal_case

# Order matters: the first matching rule wins, so the more specific field rules
# (const, then static readonly) must precede the general instance-field rule.

dotnet_naming_rule.constants_are_pascal_case.symbols = constant_symbol
dotnet_naming_rule.constants_are_pascal_case.style = pascal_style
dotnet_naming_rule.constants_are_pascal_case.severity = warning
dotnet_naming_symbols.constant_symbol.applicable_kinds = field
dotnet_naming_symbols.constant_symbol.required_modifiers = const

# `private static readonly` is PascalCase by .NET convention — it behaves like a
# constant, not like instance state.
dotnet_naming_rule.private_static_readonly_are_pascal_case.symbols = private_static_readonly_symbol
dotnet_naming_rule.private_static_readonly_are_pascal_case.style = pascal_style
dotnet_naming_rule.private_static_readonly_are_pascal_case.severity = warning
dotnet_naming_symbols.private_static_readonly_symbol.applicable_kinds = field
dotnet_naming_symbols.private_static_readonly_symbol.applicable_accessibilities = private
dotnet_naming_symbols.private_static_readonly_symbol.required_modifiers = static,readonly

dotnet_naming_rule.private_fields_are_underscore_camel.symbols = private_field_symbol
dotnet_naming_rule.private_fields_are_underscore_camel.style = underscore_camel_style
dotnet_naming_rule.private_fields_are_underscore_camel.severity = warning
dotnet_naming_symbols.private_field_symbol.applicable_kinds = field
dotnet_naming_symbols.private_field_symbol.applicable_accessibilities = private
dotnet_naming_style.underscore_camel_style.required_prefix = _
dotnet_naming_style.underscore_camel_style.capitalization = camel_case

# --- Diagnostics promoted to errors --------------------------------------
# These map directly to the legacy failures catalogued in docs/architecture.md.
dotnet_diagnostic.CS8600.severity = error   # null literal to non-nullable
dotnet_diagnostic.CS8602.severity = error   # dereference of a possibly-null reference
dotnet_diagnostic.CS8603.severity = error   # possible null reference return
dotnet_diagnostic.CS8618.severity = error   # non-nullable field uninitialised
dotnet_diagnostic.CA2007.severity = none    # ConfigureAwait not needed in ASP.NET Core
dotnet_diagnostic.CA1848.severity = none    # LoggerMessage delegates — too noisy for now
dotnet_diagnostic.CA1062.severity = none    # nullable reference types already cover this
dotnet_diagnostic.RCS1090.severity = none

# --- Rules aimed at authors of published libraries, not closed applications ---
# These exist to protect unknown third-party consumers across languages. This
# solution ships as one deployable that nobody references as a NuGet package, so
# they cost readability without buying safety. Everything disabled here is a
# style/API-shape rule; nothing that describes a correctness or security risk is.
#
# CA1716: type names that collide with VB/F# keywords (`Error`, `Result`).
# CA1000: static members on generic types (`PagedResult<T>.Empty`) — a pattern
#         the BCL itself uses throughout (`ImmutableArray<T>.Empty`).
dotnet_diagnostic.CA1716.severity = none
dotnet_diagnostic.CA1000.severity = none

# Legacy mistake #9: sync-over-async. Blocking calls are build errors.
dotnet_diagnostic.CA1849.severity = error   # call async methods when in an async method
dotnet_diagnostic.CA2016.severity = error   # forward CancellationToken

# Legacy mistake #6: dynamic SQL. Banned APIs are configured in BannedSymbols.txt.
dotnet_diagnostic.RS0030.severity = error   # symbol is banned

# Legacy mistake #14: dead code accumulating as comments.
dotnet_diagnostic.IDE0051.severity = warning  # unused private member
dotnet_diagnostic.IDE0052.severity = warning  # unread private member
dotnet_diagnostic.CS0168.severity = error     # variable declared but never used

## ---------------------------------------------------------------------------
## EF Core migrations
##
## Written by `dotnet ef migrations add`, so the style is the tool's, not ours.
## They are reviewed for schema correctness — what DDL runs against production —
## not for namespace syntax. Marking them generated stops analyzers from failing
## a build over code no human wrote.
##
## They remain fully in source control: the schema being versioned alongside the
## code is the whole point, and its absence is what made the legacy database an
## undocumented external dependency.
## ---------------------------------------------------------------------------
[**/Migrations/*.cs]
generated_code = true

## ---------------------------------------------------------------------------
## TypeScript / JavaScript / config
## ---------------------------------------------------------------------------
[*.{ts,tsx,js,jsx,mjs,cjs}]
indent_size = 2
quote_type = single

[*.{json,jsonc,json5}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.sql]
indent_size = 4
