# ---------------------------------------------------------------------------
# Copy to `.env` and adjust. `.env` is gitignored and must never be committed.
#
# The API itself does NOT read this file — it uses `dotnet user-secrets` in
# development and environment variables in every other environment. This file
# exists for the Next.js app and for docker compose.
# ---------------------------------------------------------------------------

# --- Next.js (frontend) ----------------------------------------------------
# Server-side only. The browser never sees this; all traffic is proxied
# through the BFF route handler at /api/[...path].
ERP_API_BASE_URL=http://localhost:5080

# Secret used to sign/encrypt the session cookie. Generate a fresh one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SESSION_SECRET=replace-me-with-32-random-bytes

# Public, browser-visible values only. Never put a secret behind NEXT_PUBLIC_.
NEXT_PUBLIC_APP_NAME=ERP
NEXT_PUBLIC_ENVIRONMENT=Development
