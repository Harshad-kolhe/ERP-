# ---------------------------------------------------------------------------
# Copy to `.env` and adjust. `.env` is gitignored and must never be committed.
#
#   cp .env.example .env
#
# Read by the .NET API (Program.cs loads it into environment variables before
# the configuration builder runs), by the Next.js app, and by docker compose.
#
# A real environment variable always wins over a line in this file, so CI and
# every deployed environment behave as if the file did not exist. Nothing here
# is a production mechanism — deployed environments get their configuration from
# environment variables or Azure Key Vault.
#
# Add a variable here, with a comment, in the same pull request that starts
# reading it. This file is the list every developer copies from.
# ---------------------------------------------------------------------------

# --- API (.NET) ------------------------------------------------------------
# `__` (double underscore) is .NET's section separator, so ConnectionStrings__Erp
# is the configuration key ConnectionStrings:Erp.
#
# The password below matches docker-compose.yml, which is a local-only throwaway.
# For SQL Server running natively on Windows instead of in a container, use:
#   Server=localhost;Database=Erp;Trusted_Connection=True;TrustServerCertificate=True
ConnectionStrings__Erp=Server=localhost,1433;Database=Erp;User Id=sa;Password=Local_Dev_Only_P@ssw0rd!;TrustServerCertificate=True

# NOTE: do NOT set ASPNETCORE_ENVIRONMENT here.
#
# `dotnet run` and `dotnet ef` both take it from launchSettings.json, so nothing
# needs it in this file — and setting it breaks the build. The OpenAPI document
# is emitted by starting the host during `dotnet build` (see the OpenAPI property
# group in Erp.Api.csproj), deliberately outside Development so that reading a
# schema never applies a migration or seeds a user. A value here reaches that
# process too, and `dotnet build` starts writing to your database.

# Optional. Without these the first run generates a password and logs it once,
# which is easy to miss and lost on the next database reset.
# Bootstrap__AdminEmail=admin@erp.local
# Bootstrap__AdminPassword=Local!DevOnly123

# --- Next.js (frontend) ----------------------------------------------------
# Server-side only. The browser never sees this; all traffic is proxied
# through the BFF route handler at /api/[...path].
ERP_API_BASE_URL=http://localhost:5080

# Secret used to sign/encrypt the session cookie. Generate a fresh one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SESSION_SECRET=replace-me-with-32-random-bytes

# Public, browser-visible values only. Never put a secret behind NEXT_PUBLIC_.
NEXT_PUBLIC_APP_NAME=ERP
NEXT_PUBLIC_ENVIRONMENT=Development
