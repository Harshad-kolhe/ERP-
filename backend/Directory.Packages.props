<Project>

  <!--
    Central Package Management. Versions live HERE and nowhere else — a
    <PackageReference> with a Version attribute is a build error.

    The legacy solution had EF Core 9 runtime packages beside EF Core 8 tooling
    and an ASP.NET Core 2.3 package on a net8.0 project. Central management makes
    that class of skew impossible to introduce accidentally.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Analyzers">
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
  </ItemGroup>

  <ItemGroup Label="Foundational abstractions">
    <!--
      Referenced explicitly rather than via FrameworkReference so that the inner
      layers cannot quietly acquire the whole ASP.NET Core surface. Domain and
      Application code must not see HttpContext.
    -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup Label="Persistence">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup Label="Web / hosting">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <!--
      Transitive pin. Microsoft.AspNetCore.OpenApi 10.0.10 resolves
      Microsoft.OpenApi 2.0.0, which carries a high-severity advisory
      (GHSA-v5pm-xwqc-g5wc) and therefore fails restore under NU1903.
      2.11.0 is the patched build on the same major version, so it is
      binary compatible. Remove this pin once the framework package
      resolves a fixed version on its own.
    -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.11.0" />
    <!--
      Emits the OpenAPI document during `dotnet build`, without running the app.
      The runtime document at /openapi/v1.json needs a signed-in session, so CI
      cannot simply fetch it — and starting the API, seeding a user and signing in
      just to read a schema would make the contract gate depend on the database.
    -->
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.10" />
    <PackageVersion Include="Asp.Versioning.Http" Version="10.2.1" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.16.18" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Hybrid" Version="10.8.0" />
  </ItemGroup>

  <ItemGroup Label="Validation">
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup Label="Observability">
    <!-- Structured logs go to Seq / OTLP. Never to the application database. -->
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.Seq" Version="9.1.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
  </ItemGroup>

  <ItemGroup Label="Background jobs">
    <PackageVersion Include="Hangfire.AspNetCore" Version="1.8.24" />
    <PackageVersion Include="Hangfire.SqlServer" Version="1.8.24" />
  </ItemGroup>

  <ItemGroup Label="Documents">
    <PackageVersion Include="QuestPDF" Version="2026.7.2" />
    <PackageVersion Include="ClosedXML" Version="0.105.1" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <!-- VSTest adapter, so `dotnet test` discovers xUnit v3 tests. -->
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.13.0" />
    <PackageVersion Include="Respawn" Version="7.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.8.0" />
    <PackageVersion Include="Verify.XunitV3" Version="31.28.0" />
    <PackageVersion Include="Bogus" Version="35.6.5" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
  </ItemGroup>

</Project>
