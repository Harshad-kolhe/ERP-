<Project>

  <!-- Inherit every guardrail from backend/Directory.Build.props. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xUnit v3 test projects are executables. -->
    <OutputType>Exe</OutputType>
    <!--
      Banned-API rules exist to describe production risk (raw SQL, blocking
      calls, ambient time). In test code they are advisory: a test may legitimately
      need to construct a raw command or read the wall clock to prove something.
      They stay visible as warnings rather than disappearing entirely.
    -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);RS0030</WarningsNotAsErrors>
    <!--
      CA1707 forbids underscores in member names. Snake_case test names are the
      established convention in .NET testing precisely because a test name is a
      sentence, not an identifier anyone calls.
    -->
    <!--
      CA1707  underscores in member names. Snake_case test names are the
              established convention in .NET testing: a test name is a sentence,
              not an identifier anyone calls.
      CA1711  type names ending in 'Collection'. xUnit's own convention for
              [CollectionDefinition] classes.
      xUnit1051 threading TestContext.Current.CancellationToken through every
              awaited call. It improves cancellation responsiveness of a suite
              that runs in seconds; it says nothing about correctness. Revisit if
              the suite ever grows slow enough for cancellation to matter.

      Nothing suppressed here describes a correctness or security risk.
    -->
    <NoWarn>$(NoWarn);CA1707;CA1711;xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Shouldly" />
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>

</Project>
